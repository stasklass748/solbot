# Required for the live collector. Never commit the real .env file.
PUMPPORTAL_API_KEY=

# Required for social analysis. twitterapi.io key, not an X password/cookie.
TWITTERAPI_IO_KEY=

# Optional on week one: used for a small historical probe or custom GraphQL queries.
BITQUERY_ACCESS_TOKEN=

# Optional: RPC endpoint with an API key. Used only for targeted wallet enrichment.
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=

# Storage and execution
DATABASE_PATH=./data/collector.sqlite3
LOG_LEVEL=INFO

# Internal spending caps; 0 disables the weekly stop but usage is still recorded.
SOCIAL_WEEKLY_CREDIT_CAP=0
SOCIAL_MAX_RESULTS_PER_QUERY=25
SOCIAL_CANDIDATE_MIN_VOLUME_USD=5000
SOCIAL_CANDIDATE_MIN_BUYS=20
PUMPPORTAL_MAX_TRADE_EVENTS=50000
FORENSICS_PAGE_LIMIT=500
FORENSICS_MAX_JOBS_PER_RUN=1
# One precise CA search per migrated token. Weekly usage is recorded.
SOCIAL_COLLECT_MIGRATION_BASELINE=true
SOCIAL_COLLECT_CANDIDATES=true
# Two-day X-first study. install_xfirst.sh fills the run ID and end time.
X_FIRST_ENABLED=false
X_FIRST_RUN_ID=
X_FIRST_END_AT=
X_FIRST_CREDIT_CAP=0
X_FIRST_QUERIES_PATH=x_first_queries.json
X_FIRST_FOLLOWUP_SAMPLE_PERCENT=0
# Set by start_research_v2.sh for a bounded new cohort.
SOURCE_METADATA_SINCE=
SOURCE_METADATA_END_AT=
SOURCE_METADATA_MAX_JOBS_PER_RUN=10
ENRICH_MAX_JOBS_PER_RUN=40
WALLET_WATCH_SIGNATURE_LIMIT=25
WALLET_WATCH_DETAIL_LIMIT=10

# Snapshot points after a migration. Keep 5m for early flow and 24h for labels.
SNAPSHOT_WINDOWS_MINUTES=5,15,60,360,1440,10080
# AI narrative analyst. Keep false until API keys and timers are checked.
AI_BOT_AUTO_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
TELEGRAM_BOT_TOKEN=
# Comma-separated personal chat IDs: each person receives the same card and has a private menu.
TELEGRAM_CHAT_IDS=
# Legacy single-chat setting; used only when TELEGRAM_CHAT_IDS is empty.
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
AI_MAX_POSTS_PER_RUN=5
AI_MIN_VIEWS=5000
AI_MAX_CALLS_PER_DAY=0
AI_MAX_ALERTS_PER_DAY=0
