[Unit]
Description=Bounded AI research on creator-linked X posts for migrated tokens
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=collector
WorkingDirectory=/opt/meme-narrative-collector/meme-narrative-collector
ExecStart=/usr/bin/flock -n /opt/meme-narrative-collector/meme-narrative-collector/data/migration-learning.lock /opt/meme-narrative-collector/meme-narrative-collector/.venv/bin/python -m narrative_collector.migration_learning --env-dir /opt/meme-narrative-collector/meme-narrative-collector --execute
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=300
